// JARVIS NEXUS — FINAL Firestore Rules (for ai--serverv2 app + admin)
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(db)/documents/admins/$(request.auth.uid))
        && get(/databases/$(db)/documents/admins/$(request.auth.uid)).data.get('active', false) == true;
    }

    function userBlocked() {
      return signedIn()
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'blocked';
    }

    function licenseOk(key) {
      return key is string && key != '' && key != 'none'
        && existsAfter(/databases/$(db)/documents/licenses/$(key))
        && getAfter(/databases/$(db)/documents/licenses/$(key)).data.userId == request.auth.uid
        && getAfter(/databases/$(db)/documents/licenses/$(key)).data.get('revoked', false) == false;
    }

    function deviceOwner(id) {
      return signedIn()
        && exists(/databases/$(db)/documents/devices/$(id))
        && get(/databases/$(db)/documents/devices/$(id)).data.get('userId', '') == request.auth.uid;
    }

    match /admins/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow create: if isAdmin();
      allow update: if isAdmin() && (request.auth.uid != id || request.resource.data.get('active', true) == true);
      allow delete: if isAdmin() && request.auth.uid != id;
    }

    match /licenses/{key} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() && !userBlocked()
        && resource.data.get('revoked', false) == false
        && request.resource.data.get('revoked', false) == false
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['userId', 'isUsed', 'boundDevices', 'expiresAt', 'lastUsedAt'])
        && request.resource.data.userId == request.auth.uid
        && (resource.data.get('userId', null) == null || resource.data.get('userId', null) == ''
            || resource.data.get('userId', null) == request.auth.uid)
        && request.resource.data.boundDevices.hasAll(resource.data.get('boundDevices', []))
        && request.resource.data.boundDevices.size() <= resource.data.get('boundDevices', []).size() + 1
        && request.resource.data.boundDevices.size() <= resource.data.get('maxDevices', 1)
        && (resource.data.get('expiresAt', 0) > 0
              ? (request.resource.data.expiresAt == resource.data.expiresAt
                 && resource.data.expiresAt > request.time.toMillis())
              : request.resource.data.expiresAt
                  <= request.time.toMillis() + resource.data.get('durationDays', 1) * 86400000 + 600000)
      );
    }

    match /users/{uid} {
      function entitlementOk() {
        let d = request.resource.data;
        return d.get('tier', 'basic') == 'basic'
          || (licenseOk(d.get('activeLicenseKey', null))
              && getAfter(/databases/$(db)/documents/licenses/$(d.activeLicenseKey)).data.tier == d.tier);
      }
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['status', 'role', 'isAdmin', 'blocked'])
        && entitlementOk());
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && resource.data.get('status', 'active') != 'blocked'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role', 'isAdmin', 'blocked'])
        && entitlementOk());
      allow delete: if isAdmin();
    }

    match /devices/{deviceId} {
      function devLicOk(d) {
        let k = d.get('licenseKey', d.get('activeLicenseKey', 'none'));
        return licenseOk(k)
          && getAfter(/databases/$(db)/documents/licenses/$(k)).data.boundDevices.hasAny([deviceId])
          && (d.get('tier', 'basic') == 'basic'
              || d.get('tier', 'basic') == getAfter(/databases/$(db)/documents/licenses/$(k)).data.tier);
      }
      function devExpiryOk(d) {
        let k = d.get('licenseKey', d.get('activeLicenseKey', 'none'));
        return devLicOk(d)
          && d.get('expiresAt', 0) == getAfter(/databases/$(db)/documents/licenses/$(k)).data.get('expiresAt', 0);
      }
      function privOk() {
        let d = request.resource.data;
        let aff = d.diff(resource.data).affectedKeys();
        return (!aff.hasAny(['status']) || d.status == 'pending' || (d.status == 'active' && devLicOk(d)))
          && (!aff.hasAny(['tier']) || d.tier == 'basic' || devLicOk(d))
          && (!aff.hasAny(['isPremium']) || d.isPremium == false || devLicOk(d))
          && (!aff.hasAny(['licenseKey']) || d.licenseKey == null || devLicOk(d))
          && (!aff.hasAny(['expiresAt']) || devExpiryOk(d))
          && !aff.hasAny(['expiryDate', 'blocked', 'isBlocked']);
      }
      allow get: if isAdmin() || (signedIn() && resource.data.get('userId', request.auth.uid) == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin() || (signedIn() && (
          ( request.resource.data.get('status', 'pending') == 'pending'
            && request.resource.data.get('tier', 'basic') == 'basic'
            && request.resource.data.get('isPremium', false) == false
            && !request.resource.data.keys().hasAny(['licenseKey', 'expiresAt', 'userId', 'blocked', 'isBlocked']) )
          || ( request.resource.data.get('userId', '') == request.auth.uid
               && request.resource.data.get('status', '') == 'active'
               && devLicOk(request.resource.data) ) ));
      allow update: if isAdmin() || (signedIn() && !userBlocked()
        && resource.data.get('userId', request.auth.uid) == request.auth.uid
        && resource.data.get('status', 'pending') != 'blocked'
        && request.resource.data.get('userId', request.auth.uid) == request.auth.uid
        && privOk());
      allow delete: if isAdmin();
    }

    match /network_commands/{cmdId} {
      allow create: if signedIn() && request.resource.data.get('sourceUid', '') == request.auth.uid;
      allow get, list: if isAdmin() || (signedIn() && (
          resource.data.get('sourceUid', '') == request.auth.uid
          || deviceOwner(resource.data.targetDeviceId)));
      allow update: if signedIn() && deviceOwner(resource.data.targetDeviceId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['executed', 'resultMessage', 'executedAt']);
      allow delete: if isAdmin();
    }
    match /device_network_status/{deviceId} {
      allow read: if isAdmin() || deviceOwner(deviceId);
      allow write: if signedIn() && (!exists(/databases/$(db)/documents/devices/$(deviceId)) || deviceOwner(deviceId));
    }

    match /system_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_updates/{id}           { allow read, write: if isAdmin(); }
    match /app_config/{id}            { allow read, write: if isAdmin(); }
    match /plans/{id}                 { allow read, write: if isAdmin(); }
    match /notification_requests/{id} { allow read, write: if isAdmin(); }
    match /adminAuditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
