<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_jarvis_action_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRoutineEmoji"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⚡"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRoutineName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Study Mode"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRoutineBanglaName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="পড়ার সময় প্রস্তুতি"
                android:textColor="?attr/themeAccent"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPlayRoutine"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_jarvis_pill_button"
            app:backgroundTint="@null"
            android:text="PLAY ▶"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRoutineDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Optimizes environment: checks weather, opens notes, and prepares audio."
        android:textColor="?attr/themeTextMuted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvRoutineStepsSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#12FFFFFF"
        android:padding="8dp"
        android:text="Steps: 2 actions (weather, open notes)"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="11sp"
        android:fontFamily="monospace" />

</LinearLayout>
