<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/licenseRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070814">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/licenseTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#0F1226"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnLicenseBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF"
            android:contentDescription="Back" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_settings_shield"
            app:tint="#8B5CF6"
            android:layout_marginStart="8dp"
            android:contentDescription="Shield" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREMIUM &amp; LICENSE ACTIVATION"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvLicenseSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-time Firebase Cloud Entitlement"
                android:textColor="#A78BFA"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLicenseSkip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="SKIP ❯"
            android:textAllCaps="false"
            android:textColor="#C4B5FD"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_jarvis_status_badge"
            android:paddingHorizontal="14dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/licenseTopBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Active License Status Card -->
            <LinearLayout
                android:id="@+id/cardActiveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvTierBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BASIC TIER"
                        android:textColor="#9CA3AF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:background="@drawable/bg_jarvis_status_badge"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvActivePlanStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FREE USER"
                        android:textColor="#6B7280"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvActiveKeyDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No active license assigned"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvExpiryDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Expiry: N/A"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvBoundDevicesCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Devices: 0 / 1"
                        android:textColor="#34D399"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCopyDeviceId"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Copy Device ID"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:backgroundTint="#1F2937"
                        android:textColor="#C4B5FD"
                        android:drawableStart="@drawable/ic_copy"
                        android:drawablePadding="4dp"
                        app:drawableTint="#C4B5FD" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCurrentDeviceId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Device ID: nexus_dev_..."
                    android:textColor="#6B7280"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- LIVE COUNTDOWN TIMER CARD -->
            <LinearLayout
                android:id="@+id/cardLiveCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_calendar_reminder"
                        app:tint="#38BDF8"
                        android:contentDescription="Countdown Icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="LIVE EXPIRATION COUNTDOWN"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvCountdownStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE"
                        android:textColor="#10B981"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 4 Countdown blocks: Days, Hours, Mins, Secs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center">

                    <!-- Days -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/bg_countdown_box"
                        android:paddingVertical="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCountdownDays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:textColor="#00F0FF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DAYS"
                            android:textColor="#94A3B8"
                            android:textSize="9sp"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#00F0FF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginHorizontal="4dp" />

                    <!-- Hours -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/bg_countdown_box"
                        android:paddingVertical="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCountdownHours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:textColor="#00F0FF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HOURS"
                            android:textColor="#94A3B8"
                            android:textSize="9sp"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#00F0FF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginHorizontal="4dp" />

                    <!-- Mins -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/bg_countdown_box"
                        android:paddingVertical="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCountdownMins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:textColor="#00F0FF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MINS"
                            android:textColor="#94A3B8"
                            android:textSize="9sp"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#00F0FF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginHorizontal="4dp" />

                    <!-- Secs -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/bg_countdown_box"
                        android:paddingVertical="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCountdownSecs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:textColor="#A78BFA"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SECS"
                            android:textColor="#94A3B8"
                            android:textSize="9sp"
                            android:letterSpacing="0.05" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCountdownPolicyNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="⚠️ When countdown reaches 0, license auto-expires and locks premium features immediately. Alerts: 24h &amp; 10m before."
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- DEVICE PERMISSION MAP & SLOTS -->
            <LinearLayout
                android:id="@+id/cardDeviceSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_device_phone"
                        app:tint="#34D399"
                        android:contentDescription="Device Icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="DEVICE PERMISSION SLOTS"
                        android:textColor="#34D399"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvSlotsOverview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 / 1 Slot"
                        android:textColor="#A78BFA"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Devices bound to this license key as authorized by Admin:"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <!-- Dynamic container for slot items -->
                <LinearLayout
                    android:id="@+id/containerDeviceSlots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- License Key Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_settings_lock"
                        app:tint="#F59E0B"
                        android:contentDescription="Key Icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="ENTER LICENSE KEY"
                        android:textColor="#F3E8FF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Enter or paste the license key provided by Admin (e.g. NUSRAT-AR-XXXX):"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etLicenseKey"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="ENTER LICENSE KEY"
                        android:textColor="#000000"
                        android:textColorHint="#6B7280"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:fontFamily="monospace"
                        android:background="@drawable/bg_input_field_light"
                        android:paddingHorizontal="14dp" />

                    <Button
                        android:id="@+id/btnPasteKey"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="PASTE"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:backgroundTint="#374151"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp">

                    <Button
                        android:id="@+id/btnActivateLicense"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="ACTIVATE LICENSE KEY 🗝️"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="#7C3AED"
                        android:textColor="#FFFFFF" />

                    <ProgressBar
                        android:id="@+id/pbActivating"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#FFFFFF"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Contact Admin / Website Support Button Card -->
            <LinearLayout
                android:id="@+id/cardContactAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEED A LICENSE KEY OR MULTI-DEVICE SUPPORT?"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ওয়েবসাইট বা এডমিনের সাথে কথা বলে আপনার ডিভাইস আইডি জমা দিয়ে ম্যানুয়ালি প্রিমিয়াম অ্যাক্টিভেশন চাবি পান:"
                    android:textColor="#D1D5DB"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />

                <Button
                    android:id="@+id/btnContactAdminWebsite"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="🌐 BUY LICENSE / CONTACT ADMIN WEBSITE"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#059669"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Real-time Status & Result Feedback Card -->
            <LinearLayout
                android:id="@+id/cardResultFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFeedbackTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activation Status"
                    android:textColor="#34D399"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFeedbackMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Message details..."
                    android:textColor="#E5E7EB"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Features Unlocked Matrix Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREMIUM BENEFITS (PRO / MASTER)"
                    android:textColor="#C4B5FD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="✔ Wi-Fi LAN + WAN Remote Touch &amp; Gesture Control\n✔ Real-time Cloud Telemetry &amp; Device Network Synchronization\n✔ Full Accessibility Automation Engine (WhatsApp, Dialing, YouTube)\n✔ Multi-Device Pairing &amp; Screen Mirroring via NEXUS\n✔ Priority Gemini Live Voice &amp; Vision Processing"
                    android:textColor="#D1D5DB"
                    android:textSize="11sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
