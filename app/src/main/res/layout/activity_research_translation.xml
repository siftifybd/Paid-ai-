<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBackResearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_back"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEB RESEARCH &amp; TRANSLATION"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ওয়েব অনুসন্ধান, সারাংশ ও দ্বিভাষিক অনুবাদ"
                android:textColor="?attr/themeTextMuted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Search Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_jarvis_card"
                android:padding="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INTELLIGENCE QUERY"
                    android:textColor="?attr/themeAccent"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etResearchQuery"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="Search topic (e.g. Quantum AI, Android 15)..."
                        android:textColor="?attr/themeTextPrimary"
                        android:textColorHint="?attr/themeTextMuted"
                        android:textSize="12sp"
                        android:paddingHorizontal="10dp"
                        android:maxLines="1"
                        android:inputType="text" />

                    <Button
                        android:id="@+id/btnRunResearch"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_jarvis_pill_button"
                        app:backgroundTint="@null"
                        android:text="RESEARCH"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Quick Query Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipQueryAi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_jarvis_chip"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="🤖 Gemini AI"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/chipQueryQuantum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_jarvis_chip"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="⚛️ Quantum"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/chipQueryAndroid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_jarvis_chip"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="📱 Android 15"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Research Findings Output -->
            <LinearLayout
                android:id="@+id/cardResearchOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_jarvis_card"
                android:padding="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SYNTHESIS REPORT"
                        android:textColor="?attr/themeAccent"
                        android:textSize="10sp"
                        android:letterSpacing="0.12"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <ImageButton
                        android:id="@+id/btnSpeakResearch"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_tts_play"
                        app:tint="?attr/themeAccent"
                        android:contentDescription="Read aloud" />

                    <ImageButton
                        android:id="@+id/btnCopyResearch"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_copy"
                        app:tint="?attr/themeTextMuted"
                        android:contentDescription="Copy" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvResearchSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Enter a query above to initiate a verified intelligence research task."
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:id="@+id/tvResearchKeyPoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#20FFFFFF" />

                <TextView
                    android:id="@+id/tvResearchSources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Verified Sources: None"
                    android:textColor="?attr/themeAccent"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Translation Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_jarvis_card"
                android:padding="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BILINGUAL TRANSLATOR (EN ↔ BN)"
                        android:textColor="?attr/themeAccent"
                        android:textSize="10sp"
                        android:letterSpacing="0.12"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <Button
                        android:id="@+id/btnToggleLanguageMode"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_jarvis_pill_button"
                        app:backgroundTint="@null"
                        android:text="EN ➔ BN"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etTranslationInput"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Type text or paste summary to translate..."
                    android:textColor="?attr/themeTextPrimary"
                    android:textColorHint="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:padding="10dp"
                    android:gravity="top|start" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnTranslateAction"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_jarvis_pill_button"
                        app:backgroundTint="@null"
                        android:text="TRANSLATE"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnTranslateSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_jarvis_chip"
                        android:text="USE SUMMARY"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTranslationOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_field"
                    android:padding="10dp"
                    android:text="অনুবাদিত টেক্সট এখানে প্রদর্শিত হবে..."
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
