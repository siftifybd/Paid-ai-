<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070814"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Arc Reactor Animated Visual -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center">

            <!-- Glowing core -->
            <View
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_arc_reactor_core" />

            <!-- Rotating outer rings -->
            <ImageView
                android:id="@+id/ivReactorRing"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arc_reactor_rings"
                android:contentDescription="Arc Reactor Ring" />

            <!-- Inner subtle glow -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings_shield"
                app:tint="#FFFFFF"
                android:contentDescription="Reactor Center Shield" />
        </FrameLayout>

        <!-- System Maintenance Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="SYSTEM MAINTENANCE"
            android:textColor="#00F0FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvMaintenanceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="JARVIS NEXUS Core Upgrades in Progress"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvMaintenanceMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Admin is performing scheduled cloud database maintenance and security upgrades. Normal assistant operations will resume shortly."
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_nexus_card"
            android:padding="16dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvMaintenanceEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estimated End: Checking server..."
                android:textColor="#A78BFA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Systems are being upgraded. Please check back soon."
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Action / Refresh Button -->
        <Button
            android:id="@+id/btnRefreshMaintenance"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:text="CHECK STATUS 🔄"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#7C3AED"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
