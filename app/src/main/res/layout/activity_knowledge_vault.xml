<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBackKnowledge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_back"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE KNOWLEDGE VAULT"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal documents, notes &amp; voice journals"
                android:textColor="?attr/themeTextMuted"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAddDocument"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_jarvis_chip"
            app:backgroundTint="@null"
            android:text="+ ADD NOTE"
            android:textColor="?attr/themeAccent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search Input Bar -->
    <EditText
        android:id="@+id/etSearchKnowledge"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:hint="Search knowledge, notes or documents..."
        android:textColor="?attr/themeTextPrimary"
        android:textColorHint="?attr/themeTextMuted"
        android:paddingHorizontal="14dp"
        android:textSize="13sp"
        android:singleLine="true" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKnowledge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>
