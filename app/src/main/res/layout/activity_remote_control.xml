<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/remoteControlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070814">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/remoteTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#0F1226"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnRemoteBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF"
            android:contentDescription="Back" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_nexus_wifi"
            app:tint="#8B5CF6"
            android:layout_marginStart="8dp"
            android:contentDescription="Wi-Fi Remote" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JARVIS NEXUS REMOTE CONTROL"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvRemoteSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi LAN (TLS) + WAN Relay + Touch Gesture Engine"
                android:textColor="#A78BFA"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/remoteTopBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Security Architecture Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_settings_shield"
                        app:tint="#C4B5FD"
                        android:contentDescription="Shield" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="HOW PIN + TLS REMOTE CONTROL WORKS"
                        android:textColor="#F3E8FF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• TLS 1.3 Encryption: Uses AndroidKeyStore self-signed RSA-2048 identity. All socket traffic is 100% encrypted.\n• PIN &amp; PBKDF2 Auth: PBKDF2-SHA256 salted PIN verification with automatic lockout (5 failed attempts = 5-min lock).\n• Zero-Config LAN: Auto-discovered via NSD/mDNS (_jarvis-remote._tcp.) and UDP broadcast on port 8791.\n• Accessibility Engine: Dispatches precise touch gestures (tap, double tap, long press, swipe, scroll, key, text, launch_app)."
                    android:textColor="#D1D5DB"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Step 1: Accessibility Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_screen_share"
                        app:tint="#A78BFA"
                        android:contentDescription="Accessibility Icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="1. ACCESSIBILITY ENGINE PERMISSION"
                        android:textColor="#C4B5FD"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAccessibilityStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Accessibility: Checking..."
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Required to execute system gestures (tap, swipe, keypress, open app) received over Wi-Fi."
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnEnableAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:text="Enable Accessibility Service"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:backgroundTint="#7C3AED"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Step 2: Server Toggle Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nexus_wifi"
                        app:tint="#34D399"
                        android:contentDescription="Server Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. REMOTE CONTROL SERVER ENGINE"
                            android:textColor="#C4B5FD"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tvServerStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Server: Stopped"
                            android:textColor="#EF4444"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchServer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvServerDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="LAN TLS WebSocket Server + NSD (mDNS) discovery."
                    android:textColor="#D1D5DB"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvActiveClients"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Active Connections: 0 / 3"
                    android:textColor="#34D399"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnCopyConnectionInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:text="Copy Controller Setup Config"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:backgroundTint="#374151"
                    android:textColor="#C4B5FD"
                    android:drawableStart="@drawable/ic_copy"
                    android:drawablePadding="6dp"
                    app:drawableTint="#C4B5FD"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Step 3: Security & PIN Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_settings_lock"
                        app:tint="#F59E0B"
                        android:contentDescription="Lock Icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="3. SECURITY AUTHENTICATION (PIN &amp; TLS)"
                        android:textColor="#C4B5FD"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPinStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="PIN Status: Checking..."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvActivePin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=""
                    android:textColor="#10B981"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnGeneratePin"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Generate 8-Digit PIN"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:backgroundTint="#7C3AED"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnSetCustomPin"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Set Custom PIN"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:backgroundTint="#374151"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="TLS Certificate SHA-256 Fingerprint:"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvFingerprint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Loading..."
                    android:textColor="#C4B5FD"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/btnCopyFingerprint"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:text="Copy TLS Fingerprint"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:backgroundTint="#1F2937"
                    android:textColor="#C4B5FD"
                    android:drawableStart="@drawable/ic_copy"
                    android:drawablePadding="6dp"
                    app:drawableTint="#C4B5FD" />
            </LinearLayout>

            <!-- Step 4: Optional WAN Relay Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_globe_more"
                        app:tint="#60A5FA"
                        android:contentDescription="Globe Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4. INTERNET RELAY ENGINE (OPTIONAL WAN)"
                            android:textColor="#C4B5FD"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="End-to-End AES-256-GCM Encrypted Cloud Transport"
                            android:textColor="#9CA3AF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchWan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutWanConfig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etRelayUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Relay Server URL (wss://...)"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#6B7280"
                        android:textSize="13sp"
                        android:inputType="textUri"
                        android:background="@drawable/bg_input_field"
                        android:padding="10dp" />

                    <EditText
                        android:id="@+id/etRelayToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Relay Authentication Token"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#6B7280"
                        android:textSize="13sp"
                        android:inputType="text"
                        android:background="@drawable/bg_input_field"
                        android:padding="10dp" />

                    <Button
                        android:id="@+id/btnSaveRelayConfig"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:text="Save Relay Settings"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:backgroundTint="#374151"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Pairing Key (256-bit AES-GCM):"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvPairingKey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="#F59E0B"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCopyPairingKey"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Copy Key"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            android:backgroundTint="#1F2937"
                            android:textColor="#F59E0B"
                            android:drawableStart="@drawable/ic_copy"
                            android:drawablePadding="6dp"
                            app:drawableTint="#F59E0B" />

                        <Button
                            android:id="@+id/btnRotatePairingKey"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:text="Rotate Key"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            android:backgroundTint="#1F2937"
                            android:textColor="#EF4444" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Step 5: Live Gesture Control Test Studio Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_brain_memory"
                        app:tint="#EC4899"
                        android:contentDescription="Brain Icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="5. LIVE GESTURE CONTROL TEST STUDIO"
                        android:textColor="#C4B5FD"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Test remote gesture actions directly on this device to verify execution:"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTestTapCenter"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Test Tap Center"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:backgroundTint="#1F2937"
                        android:textColor="#F3E8FF" />

                    <Button
                        android:id="@+id/btnTestHome"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Test Home Key"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:backgroundTint="#1F2937"
                        android:textColor="#F3E8FF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTestRecents"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Test Recents Key"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:backgroundTint="#1F2937"
                        android:textColor="#F3E8FF" />

                    <Button
                        android:id="@+id/btnTestSwipe"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Test Swipe Up"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:backgroundTint="#1F2937"
                        android:textColor="#F3E8FF" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
