<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBackDigest"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_back"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTIFICATION DIGEST"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Priority inbox &amp; voice readout"
                android:textColor="?attr/themeTextMuted"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReadAloudDigest"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_jarvis_pill_button"
            app:backgroundTint="@null"
            android:text="READ DIGEST 🔊"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Permission Banner -->
    <LinearLayout
        android:id="@+id/layoutListenerPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_jarvis_card"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivListenerStatus"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_settings_shield"
            app:tint="?attr/themeAccent"
            android:contentDescription="Listener Status" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvListenerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Notification Access"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvListenerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Allow JARVIS to triage incoming alerts securely."
                android:textColor="?attr/themeTextMuted"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGrantListenerAccess"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_jarvis_pill_button"
            app:backgroundTint="@null"
            android:text="GRANT ACCESS"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_jarvis_card"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_nav_bell"
            app:tint="?attr/themeAccent"
            android:contentDescription="Notification Icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Filters incoming alerts by priority on-device. Spoken readouts respect meeting and driving profiles."
            android:textColor="?attr/themeTextMuted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnClearDigest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLEAR"
            android:textColor="?attr/themeAccent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="6dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifications"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>
