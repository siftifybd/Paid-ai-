<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootMainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="?attr/themeBg">

    <!-- Fragment Container for Home, Chat, Settings, and Updates -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sleek Liquid Glass Floating Navigation Capsule -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_jarvis_dock"
        android:elevation="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tab 1: Home -->
        <FrameLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pillTabHome"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:minWidth="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_dock_item_active">

                <ImageView
                    android:id="@+id/ivTabHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_home"
                    app:tint="?attr/themeTextPrimary"
                    android:contentDescription="Home" />

                <TextView
                    android:id="@+id/tvTabHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/themeTextPrimary" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 2: Chat -->
        <FrameLayout
            android:id="@+id/tabChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pillTabChat"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:minWidth="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:id="@+id/ivTabChat"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_chat"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Chat" />

                <TextView
                    android:id="@+id/tvTabChat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/themeTextMuted" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 3: Voice / Mic (Hero Highlighted Action) -->
        <FrameLayout
            android:id="@+id/tabMic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pillTabMic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:translationY="-8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_dock_mic_highlight">

                <ImageView
                    android:id="@+id/ivTabMic"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_mic_jarvis"
                    app:tint="#FFFFFF"
                    android:contentDescription="Voice" />

                <TextView
                    android:id="@+id/tvTabMic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voice"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 4: Settings -->
        <FrameLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pillTabSettings"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:minWidth="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:id="@+id/ivTabSettings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Settings" />

                <TextView
                    android:id="@+id/tvTabSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/themeTextMuted" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 5: Updates -->
        <FrameLayout
            android:id="@+id/tabUpdates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pillTabUpdates"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:minWidth="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivTabUpdates"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_bell"
                        app:tint="?attr/themeTextMuted"
                        android:contentDescription="Updates" />

                    <View
                        android:id="@+id/badgeUpdates"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_jarvis_mic_center"
                        android:backgroundTint="@color/status_red" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTabUpdates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Updates"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/themeTextMuted" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- Glowing Liquid Glass Curved Line arching over the center Mic button -->
    <com.jarvis.assistant.ui.widget.CurvedDockLineView
        android:id="@+id/dockCurvedLine"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:elevation="14dp"
        app:layout_constraintStart_toStartOf="@id/bottomDock"
        app:layout_constraintEnd_toEndOf="@id/bottomDock"
        app:layout_constraintTop_toTopOf="@id/bottomDock"
        android:layout_marginTop="-21dp" />

    <!-- High-Tech Lock Overlay when Firestore device status is not active -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutDeviceLockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA070814"
        android:elevation="40dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_jarvis_mic_center"
                    android:backgroundTint="#26F59E0B" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings_lock"
                    app:tint="#F59E0B"
                    android:contentDescription="Device Locked" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="DEVICE LOCKED"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvLockCloudStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Awaiting Firestore 'status: active' approval"
                android:textColor="#FDE68A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Device ID Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_nexus_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR UNIQUE DEVICE IDENTIFIER:"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvLockDeviceId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="nexus_dev_..."
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="This device is locked. To gain full access, the Firestore cloud database document must have status: active, or enter an authorized license key."
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnOpenLicenseFromLock"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:text="OPEN LICENSE OVERLAY 🗝️"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#7C3AED" />

            <Button
                android:id="@+id/btnContactAdminFromLock"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="🌐 CONTACT ADMIN / BUY LICENSE"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#059669" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminateTint="#38BDF8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Listening to Firestore in real-time..."
                    android:textColor="#38BDF8"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer on Start/Left -->
    <include
        android:id="@+id/drawerMenu"
        layout="@layout/layout_jarvis_drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
