<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_slot_card"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/ivSlotIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_device_phone"
        app:tint="#34D399"
        android:contentDescription="Device Slot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvSlotTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Slot 1: This Device"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSlotDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: nexus_dev_... • Bound"
            android:textColor="#9CA3AF"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSlotBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACTIVE"
        android:textColor="#34D399"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@drawable/bg_jarvis_status_badge_green"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp" />

</LinearLayout>
