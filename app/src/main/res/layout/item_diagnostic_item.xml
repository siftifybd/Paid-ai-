<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_jarvis_action_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDiagnosticTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Audio Microphone Sensor"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDiagnosticStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_jarvis_status_badge_green"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="OPERATIONAL"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDiagnosticSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Recording permission granted and audio hardware accessible."
        android:textColor="?attr/themeTextMuted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnDiagnosticAction"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_jarvis_chip"
        app:backgroundTint="@null"
        android:text="FIX / RESOLVE"
        android:textColor="?attr/themeAccent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
