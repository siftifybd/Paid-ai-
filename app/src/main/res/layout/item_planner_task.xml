<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_jarvis_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <!-- Checkbox Check -->
    <CheckBox
        android:id="@+id/cbTaskDone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:buttonTint="?attr/themeAccent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calibrate Sub-systems"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTaskPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_jarvis_status_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="HIGH"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTaskNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Verify Vosk speech buffer &amp; Gemini socket"
            android:textColor="?attr/themeTextMuted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTaskTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕒 18:00"
                android:textColor="?attr/themeAccent"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvTaskRecurrence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="🔁 Daily"
                android:textColor="?attr/themeTextMuted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnDeleteTask"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_delete"
        app:tint="?attr/themeTextMuted"
        android:contentDescription="Delete Task" />

</LinearLayout>
